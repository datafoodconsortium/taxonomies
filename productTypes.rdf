<rdf:Description rdf:about="http://w3id.org/dfc/taxonomies//productTypes.rdf">
	<rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
	<dct:title xml:lang="en">Product Types</dct:title>
	<dct:title xml:lang="fr">Types de produits</dct:title>
	<dct:description xml:lang="fr">Les différentes catégories de produit, classifiées en arborescence</dct:description>
	<dct:description xml:lang="en">The categories of the products, ordered as a tree</dct:description>
	<skos:hasTopConcept rdf:resource="https://w3id.org/dfc/taxonomies/productTypes.rdf#dairy-product"/>
