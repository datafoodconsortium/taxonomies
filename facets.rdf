<rdf:Description rdf:about="http://w3id.org/dfc/taxonomies/facets.rdf#NatureOrigin">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<rdfs:comment xml:lang="en">We made the list for the prototype with open nomenclature to start with for plants and animals but might be better to connected directly from relevant source ontologies for variaties, races, etc. (http://open-nomenclature.org/fra/nomenclatures/varieties/tree).</rdfs:comment>
	<dct:description xml:lang="fr">Source "vivante" d'origine concernée</dct:description>
	<dct:description xml:lang="en">Natural "living" origin concerned</dct:description>
