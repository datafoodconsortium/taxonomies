<rdf:Description rdf:about="http://w3id.org/dfc/taxonomies/facets.rdf#BiodynamicLabel">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#DFC_ProductGlossary_Facet"/>
