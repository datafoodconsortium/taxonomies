	<skos:narrower rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#EthicalLabel"/>
	<skos:narrower rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#LocalLabel"/>
	<skos:narrower rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#BiodynamicLabel"/>
	<skos:narrower rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#OrganicLabel"/>
