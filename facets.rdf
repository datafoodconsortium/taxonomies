</rdf:Description>

<rdf:Description rdf:about="http://w3id.org/dfc/taxonomies/facets.rdf#HenBody">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#DFC_ProductGlossary_Facet"/>
	<skos:inScheme rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#DFCProductGlossaryFacet"/>
	<skos:prefLabel xml:lang="en">Hen's body</skos:prefLabel>
	<skos:prefLabel xml:lang="fr">Partie de poule</skos:prefLabel>
	<skos:broader rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#Hen"/>
</rdf:Description>

<rdf:Description rdf:about="http://w3id.org/dfc/taxonomies/facets.rdf#Hen">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:inScheme rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#DFC_ProductGlossary_Facet"/>
	<skos:inScheme rdf:resource="http://w3id.org/dfc/taxonomies/facets.rdf#DFCProductGlossaryFacet"/>
