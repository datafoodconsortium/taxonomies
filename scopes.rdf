	<skos:prefLabel xml:lang="fr">Lire les commandes de l'entreprise</skos:prefLabel>
	<skos:notation>ReadOrders</skos:notation>
</rdf:Description>

<rdf:Description rdf:about="https://github.com/datafoodconsortium/taxonomies/releases/latest/download/scopes.rdf#ReadProducts">
